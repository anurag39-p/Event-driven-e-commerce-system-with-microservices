# ---- PostgreSQL (runs in Docker via docker-compose) ----
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=ecommerce
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- MongoDB (using your local install, not containerized) ----
# host.docker.internal lets containers reach services running on your host machine
MONGO_URI=mongodb://host.docker.internal:27017/ecommerce_products

# ---- RabbitMQ (runs in Docker) ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# Management UI: http://localhost:15672  (user: guest / pass: guest)

# ---- JWT ----
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Service ports (used only if running services outside Docker) ----
USER_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
PAYMENT_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005
GATEWAY_PORT=4000
